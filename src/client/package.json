{
  "name": "aspnetdesktop-client",
  "version": "0.1.0",
  "description": "DesktopHttpClient: isolated, HTTP-shaped calls from the WebView UI to the in-process ASP.NET Core API over ipc://localhost, with Angular, React and Vue integrations. Never touches the global fetch or Angular's HttpClient.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Arman Ossi Loko",
  "homepage": "https://github.com/armanossiloko/aspnet-desktop/tree/master/src/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armanossiloko/aspnet-desktop.git",
    "directory": "src/client"
  },
  "bugs": {
    "url": "https://github.com/armanossiloko/aspnet-desktop/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "aspnetcore",
    "desktop",
    "webview",
    "ipc",
    "angular",
    "react",
    "vue",
    "httpclient"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0",
    "@angular/core": ">=19.0.0",
    "react": ">=18.0.0",
    "rxjs": "^7.4.0",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
