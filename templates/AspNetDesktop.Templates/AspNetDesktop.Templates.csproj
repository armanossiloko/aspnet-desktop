<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet new templates built from the samples (samples/*/.template.config). At pack time the samples are copied
    without build output, with AspNetDesktop set to this package's version and aspnetdesktop-client to the client's.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>AspNetDesktop.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Description>dotnet new templates for AspNetDesktop: desktop apps with an in-process ASP.NET Core backend and an Angular (aspnetdesktop-angular), React (aspnetdesktop-react) or Vue (aspnetdesktop-vue) UI.</Description>
    <PackageTags>$(PackageTags);dotnet-new;templates</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnablePackageValidation>false</EnablePackageValidation>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- No lib/ folder is expected in a template package. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TemplatesStagingDir>$(BaseIntermediateOutputPath)templates/</TemplatesStagingDir>
    <!--
      Where generated apps install aspnetdesktop-client from: npmjs, or github (GitHub Packages). GitHub Packages only
      serves scoped packages, so there the dependency is an alias to @owner/aspnetdesktop-client and imports stay the same.
    -->
    <TemplateNpmRegistry Condition="'$(TemplateNpmRegistry)' == ''">npmjs</TemplateNpmRegistry>
    <GitHubPackagesOwner>armanossiloko</GitHubPackagesOwner>
  </PropertyGroup>

  <ItemGroup>
    <TemplateSource Include="Angular" SourceDir="$(AspNetDesktopRepoRoot)samples/AngularApp/" />
    <TemplateSource Include="React" SourceDir="$(AspNetDesktopRepoRoot)samples/ReactApp/" />
    <TemplateSource Include="Vue" SourceDir="$(AspNetDesktopRepoRoot)samples/VueApp/" />
  </ItemGroup>

  <UsingTask TaskName="StageTemplateFile" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Required="true" />
      <ClientDependency ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        string name = Path.GetFileName(Source);
        if (name.EndsWith(".csproj") || name == "package.json")
        {
            string text = File.ReadAllText(Source);
            text = Regex.Replace(text, "(<PackageReference Include=\"AspNetDesktop\" Version=\")[^\"]*(\")", "${1}" + Version + "${2}");
            text = Regex.Replace(text, "(\"aspnetdesktop-client\": \")[^\"]*(\")", "${1}" + ClientDependency + "${2}");
            File.WriteAllText(Destination, text);
        }
        else
        {
            File.Copy(Source, Destination, overwrite: true);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StageTemplates" BeforeTargets="_GetPackageFiles" DependsOnTargets="MinVer">
    <ItemGroup>
      <_TemplateFile Include="%(TemplateSource.SourceDir)**/*" Exclude="%(TemplateSource.SourceDir)bin/**;%(TemplateSource.SourceDir)obj/**;%(TemplateSource.SourceDir)wwwroot/**;%(TemplateSource.SourceDir)ClientApp/node_modules/**;%(TemplateSource.SourceDir)ClientApp/dist/**;%(TemplateSource.SourceDir)ClientApp/.angular/**;%(TemplateSource.SourceDir)**/*.user" TemplateName="%(TemplateSource.Identity)" />
    </ItemGroup>

    <Error Condition="'$(TemplateNpmRegistry)' != 'npmjs' and '$(TemplateNpmRegistry)' != 'github'" Text="TemplateNpmRegistry must be 'npmjs' or 'github', not '$(TemplateNpmRegistry)'." />
    <!-- The npm client has its own version (release-please bumps src/client/package.json); use the current one. -->
    <PropertyGroup>
      <_ClientPackageJson>$([System.IO.File]::ReadAllText('$(AspNetDesktopRepoRoot)src/client/package.json'))</_ClientPackageJson>
      <_TemplateClientVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ClientPackageJson), '(?&lt;="version":\s*")[^"]+').Value)</_TemplateClientVersion>
      <_TemplateClientDependency>^$(_TemplateClientVersion)</_TemplateClientDependency>
      <_TemplateClientDependency Condition="'$(TemplateNpmRegistry)' == 'github'">npm:%40$(GitHubPackagesOwner)/aspnetdesktop-client@^$(_TemplateClientVersion)</_TemplateClientDependency>
    </PropertyGroup>
    <Error Condition="'$(_TemplateClientVersion)' == ''" Text="Could not read the version from src/client/package.json." />

    <RemoveDir Directories="$(TemplatesStagingDir)" />
    <StageTemplateFile Source="%(_TemplateFile.FullPath)" Destination="$(TemplatesStagingDir)%(_TemplateFile.TemplateName)/%(_TemplateFile.RecursiveDir)%(_TemplateFile.Filename)%(_TemplateFile.Extension)" Version="$(PackageVersion)" ClientDependency="$(_TemplateClientDependency)" />
    <!-- Route the scope to GitHub Packages; the read:packages token stays in the user's own ~/.npmrc. -->
    <WriteLinesToFile Condition="'$(TemplateNpmRegistry)' == 'github'" File="$(TemplatesStagingDir)%(TemplateSource.Identity)/ClientApp/.npmrc" Lines="%40$(GitHubPackagesOwner):registry=https://npm.pkg.github.com" Overwrite="true" />

    <ItemGroup>
      <_StagedTemplateFile Include="$(TemplatesStagingDir)**/*" />
      <None Include="@(_StagedTemplateFile)" Pack="true" PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
