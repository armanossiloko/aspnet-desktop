{
  "name": "aspnet-desktop",
  "private": true,
  "workspaces": [
    "src/client",
    "samples/AngularApp/ClientApp",
    "samples/ReactApp/ClientApp"
  ],
  "scripts": {
    "build:client": "npm run build -w aspnetdesktop-client",
    "test:client": "npm test -w aspnetdesktop-client",
    "build:samples": "npm run build:client && npm run build -w angular-app-client -w react-app-client",
    "start:angular": "npm start -w angular-app-client",
    "start:react": "npm start -w react-app-client"
  }
}
